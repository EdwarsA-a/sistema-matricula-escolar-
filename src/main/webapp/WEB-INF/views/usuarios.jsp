<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<div class="page-heading"><div><span class="eyebrow">ACCESOS</span><h1>Usuarios y roles</h1><p>Crea cuentas individuales y controla su estado.</p></div></div>
<section class="panel"><h2>Crear cuenta</h2><form class="form-grid" method="post" action="<c:url value='/app/usuarios/guardar'/>"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><label>Nombre<input name="nombre" maxlength="100" required></label><label>Usuario<input name="username" minlength="3" maxlength="50" autocomplete="off" required></label><label>Contraseña<input type="password" name="password" minlength="12" maxlength="128" autocomplete="new-password" required></label><label>Rol<select name="rol"><option value="MATRICULA">Personal de matrícula</option><option value="DIRECTOR">Director o coordinador</option><option value="ADMIN">Administrador</option></select></label><div class="full"><button>Crear cuenta</button></div></form></section>
<section class="panel"><h2>Cuentas registradas</h2><table><thead><tr><th>Nombre</th><th>Usuario</th><th>Rol</th><th>Estado</th><th></th></tr></thead><tbody><c:forEach items="${rows}" var="row"><tr><td><c:out value="${row.nombre}"/></td><td><c:out value="${row.username}"/></td><td><c:out value="${row.rol}"/></td><td>${row.activo ? 'Activo' : 'Inactivo'}</td><td><c:if test="${row.id ne sessionScope.usuario.id}"><form method="post" action="<c:url value='/app/usuarios/estado'/>"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="id" value="${row.id}"><c:if test="${not row.activo}"><input type="hidden" name="activo" value="on"></c:if><button class="small secondary">${row.activo ? 'Desactivar' : 'Activar'}</button></form></c:if></td></tr></c:forEach></tbody></table></section>
