<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<div class="page-heading"><div><span class="eyebrow">RELACIONES</span><h1>Vínculos familiares</h1><p>Un apoderado puede representar a varios estudiantes.</p></div></div>
<section class="panel"><h2>Vincular un responsable</h2><form class="form-grid" method="post" action="<c:url value='/app/vinculos/guardar'/>"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>">
<label>Estudiante<select name="estudiante_id" required><option value="">Seleccione</option><c:forEach items="${estudiantes}" var="e"><option value="${e.id}"><c:out value="${e.codigo}"/> · <c:out value="${e.apellidos}"/>, <c:out value="${e.nombres}"/></option></c:forEach></select></label>
<label>Apoderado<select name="apoderado_id" required><option value="">Seleccione</option><c:forEach items="${apoderados}" var="a"><option value="${a.id}"><c:out value="${a.documento}"/> · <c:out value="${a.apellidos}"/>, <c:out value="${a.nombres}"/></option></c:forEach></select></label>
<label>Vínculo<select name="vinculo"><option>Madre</option><option>Padre</option><option>Apoderado</option><option>Otro responsable</option></select></label><label class="check"><input type="checkbox" name="principal">Responsable principal</label><div class="full"><button>Guardar vínculo</button></div></form></section>
<section class="panel"><h2>Vínculos registrados</h2><div class="table-scroll"><table><thead><tr><th>Estudiante</th><th>Apoderado</th><th>Vínculo</th><th>Principal</th></tr></thead><tbody><c:forEach items="${rows}" var="row"><tr><td><c:out value="${row.codigo}"/> · <c:out value="${row.estudiante}"/></td><td><c:out value="${row.apoderado}"/></td><td><c:out value="${row.vinculo}"/></td><td>${row.principal ? 'Sí' : 'No'}</td></tr></c:forEach><c:if test="${empty rows}"><tr><td colspan="4">Todavía no hay vínculos registrados.</td></tr></c:if></tbody></table></div></section>
