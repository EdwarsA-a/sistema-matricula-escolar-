<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<div class="page-heading"><div><span class="eyebrow">CONSULTA ACADÉMICA</span><h1>Vacantes y reportes</h1><p>Capacidad total, matrículas activas y disponibilidad por sección.</p></div><button class="secondary no-print" data-print>Imprimir reporte</button></div>
<section class="panel no-print"><form class="inline" method="get"><label>Periodo<select name="periodo_id"><option value="">Todos los periodos</option><c:forEach items="${periodos}" var="p"><option value="${p.id}" ${periodo_id eq p.id ? 'selected' : ''}><c:out value="${p.codigo}"/></option></c:forEach></select></label><button>Consultar</button></form></section>
<section class="panel"><h2>Disponibilidad de secciones</h2><p class="muted">Generado: <c:out value="${generado}"/></p><div class="table-scroll"><table><thead><tr><th>Periodo</th><th>Nivel</th><th>Grado</th><th>Sección</th><th>Capacidad</th><th>Activas</th><th>Disponibles</th></tr></thead><tbody><c:forEach items="${rows}" var="row"><tr><td><c:out value="${row.periodo}"/></td><td><c:out value="${row.nivel}"/></td><td><c:out value="${row.grado}"/></td><td><c:out value="${row.seccion}"/></td><td><c:out value="${row.capacidad}"/></td><td><c:out value="${row.ocupadas}"/></td><td><strong><c:out value="${row.disponibles}"/></strong></td></tr></c:forEach><c:if test="${empty rows}"><tr><td colspan="7">No hay secciones para el filtro seleccionado.</td></tr></c:if></tbody></table></div></section>
<section class="panel"><h2>Matrículas por estado</h2><table><thead><tr><th>Periodo</th><th>Estado</th><th>Cantidad</th></tr></thead><tbody><c:forEach items="${estados}" var="row"><tr><td><c:out value="${row.periodo}"/></td><td><c:out value="${row.estado}"/></td><td><c:out value="${row.cantidad}"/></td></tr></c:forEach><c:if test="${empty estados}"><tr><td colspan="3">Todavía no hay matrículas registradas.</td></tr></c:if></tbody></table></section>
