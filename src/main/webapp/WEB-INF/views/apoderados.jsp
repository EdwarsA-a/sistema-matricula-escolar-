<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<div class="page-heading"><div><span class="eyebrow">RESPONSABLES</span><h1>Apoderados</h1><p>Registra al responsable una sola vez y vincúlalo con sus estudiantes.</p></div></div>
<section class="panel"><h2>${empty edit ? 'Nuevo apoderado' : 'Actualizar apoderado'}</h2><form class="form-grid" method="post" action="<c:url value='/app/apoderados/guardar'/>"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="id" value="<c:out value='${edit.id}'/>">
<label>Tipo de documento<select name="tipo_documento"><option ${edit.tipo_documento eq 'DNI' ? 'selected' : ''}>DNI</option><option ${edit.tipo_documento eq 'CE' ? 'selected' : ''}>CE</option><option ${edit.tipo_documento eq 'PASAPORTE' ? 'selected' : ''}>PASAPORTE</option><option ${edit.tipo_documento eq 'OTRO' ? 'selected' : ''}>OTRO</option></select></label><label>Documento<input name="documento" value="<c:out value='${edit.documento}'/>" maxlength="20" required></label>
<label>Nombres<input name="nombres" maxlength="80" value="<c:out value='${edit.nombres}'/>" required></label><label>Apellidos<input name="apellidos" maxlength="100" value="<c:out value='${edit.apellidos}'/>" required></label>
<label>Teléfono<input name="telefono" maxlength="25" value="<c:out value='${edit.telefono}'/>" required></label><label>Correo electrónico<input name="email" type="email" maxlength="120" value="<c:out value='${edit.email}'/>"></label><label class="check full"><input type="checkbox" name="activo" ${empty edit or edit.activo ? 'checked' : ''}>Apoderado activo</label>
<div class="actions full"><button>Guardar apoderado</button><a class="button secondary" href="<c:url value='/app/apoderados'/>">Limpiar formulario</a></div></form></section>
<section class="panel"><form class="search" method="get"><input name="q" placeholder="Documento o nombre" value="<c:out value='${q}'/>"><button>Buscar</button></form><div class="table-scroll"><table><thead><tr><th>Documento</th><th>Apoderado</th><th>Teléfono</th><th>Correo</th><th>Estado</th><th></th></tr></thead><tbody><c:forEach items="${rows}" var="row"><tr><td><c:out value="${row.documento}"/></td><td><c:out value="${row.apellidos}"/>, <c:out value="${row.nombres}"/></td><td><c:out value="${row.telefono}"/></td><td><c:out value="${row.email}"/></td><td>${row.activo ? 'Activo' : 'Inactivo'}</td><td><a href="<c:url value='/app/apoderados'><c:param name='editar' value='${row.id}'/></c:url>">Editar</a></td></tr></c:forEach><c:if test="${empty rows}"><tr><td colspan="6">No se encontraron apoderados.</td></tr></c:if></tbody></table></div></section>
