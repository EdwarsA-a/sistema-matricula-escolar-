<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<div class="page-heading"><div><span class="eyebrow">DETALLE DE MATRÍCULA</span><h1><c:out value="${matricula.estudiante}"/></h1><p><c:out value="${matricula.codigo}"/></p></div><a class="button secondary" href="<c:url value='/app/matriculas'/>">Volver a matrículas</a></div>
<section class="panel"><dl class="details"><div><dt>Periodo</dt><dd><c:out value="${matricula.periodo}"/></dd></div><div><dt>Sección</dt><dd><c:out value="${matricula.seccion}"/></dd></div><div><dt>Estado</dt><dd><span class="badge"><c:out value="${matricula.estado}"/></span></dd></div><div><dt>Responsable</dt><dd><c:out value="${matricula.responsable_apellidos}"/> <c:out value="${matricula.responsable_nombres}"/><c:if test="${empty matricula.apoderado_id}">Sin asignar</c:if></dd></div></dl><p><c:out value="${matricula.observacion}"/></p></section>
<c:if test="${matricula.estado eq 'PENDIENTE'}"><section class="panel"><h2>Responsable de esta matrícula</h2><form class="form-grid" method="post" action="<c:url value='/app/matriculas/operar'/>"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="id" value="${matricula.id}"><input type="hidden" name="accion" value="RESPONSABLE"><label>Apoderado vinculado<select name="apoderado_id" required><option value="">Seleccione</option><c:forEach items="${responsables}" var="a"><option value="${a.id}" ${matricula.apoderado_id eq a.id ? 'selected' : ''}><c:out value="${a.apellidos}"/>, <c:out value="${a.nombres}"/> · <c:out value="${a.vinculo}"/></option></c:forEach></select></label><div class="actions"><button>Asignar responsable</button><a href="<c:url value='/app/vinculos'/>">Registrar un vínculo</a></div></form></section></c:if>
<section class="panel"><h2>Revisión documental</h2><p>Marca un requisito solo después de verificarlo. Los requisitos obligatorios deben estar completos para activar.</p><div class="table-scroll"><table><thead><tr><th>Requisito</th><th>Obligatorio</th><th>Estado</th><th>Revisión</th></tr></thead><tbody><c:forEach items="${documentos}" var="d"><tr><td><c:out value="${d.nombre}"/></td><td>${d.obligatorio ? 'Sí' : 'No'}</td><td>${d.verificado ? 'Verificado' : 'Pendiente'}<small><c:out value="${d.verificador}"/> <c:out value="${d.verificado_en}"/></small></td><td><c:if test="${matricula.estado eq 'PENDIENTE'}"><form class="inline" method="post" action="<c:url value='/app/matriculas/operar'/>"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="id" value="${matricula.id}"><input type="hidden" name="accion" value="DOCUMENTO"><input type="hidden" name="tipo_documento_id" value="${d.id}"><label class="check"><input type="checkbox" name="verificado" ${d.verificado ? 'checked' : ''}>Verificado</label><button class="small secondary">Guardar</button></form></c:if></td></tr></c:forEach></tbody></table></div></section>
<c:if test="${matricula.estado eq 'PENDIENTE'}"><section class="panel"><h2>Confirmar matrícula</h2><form method="post" action="<c:url value='/app/matriculas/operar'/>" data-confirm="¿Confirmar la activación de esta matrícula?"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="id" value="${matricula.id}"><input type="hidden" name="accion" value="ACTIVACION"><label>Motivo<input name="motivo" maxlength="500" value="Requisitos de matrícula verificados" required></label><button>Activar matrícula</button></form></section></c:if>
<c:if test="${matricula.estado eq 'ACTIVA'}"><section class="panel"><h2>Cambio de sección</h2><form class="form-grid" method="post" action="<c:url value='/app/matriculas/operar'/>"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="id" value="${matricula.id}"><input type="hidden" name="accion" value="CAMBIO_SECCION"><label>Destino en el mismo grado<select name="destino_id" required><option value="">Seleccione</option><c:forEach items="${destinos}" var="d"><option value="${d.id}"><c:out value="${d.nombre}"/> · <c:out value="${d.disponibles}"/> vacantes</option></c:forEach></select></label><label>Motivo<input name="motivo" maxlength="500" required></label><div class="full"><button>Cambiar sección</button></div></form></section></c:if>
<c:if test="${sessionScope.usuario.administrador and (matricula.estado eq 'ACTIVA' or matricula.estado eq 'PENDIENTE')}"><section class="panel"><h2>Movimientos administrativos</h2><p>Se conserva el registro y su historial. Estas operaciones requieren el rol administrador.</p><form class="form-grid" method="post" action="<c:url value='/app/matriculas/operar'/>" data-confirm="¿Registrar este movimiento administrativo? Se conservará el historial."><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="id" value="${matricula.id}"><label>Operación<select name="accion"><option value="ANULACION">Anular matrícula</option><c:if test="${matricula.estado eq 'ACTIVA'}"><option value="RETIRO">Retirar estudiante</option><option value="TRASLADO_EXTERNO">Registrar traslado a otra institución</option></c:if></select></label><label>Motivo<input name="motivo" maxlength="500" required></label><div class="full"><button class="danger">Registrar movimiento</button></div></form></section></c:if>
<section class="panel"><h2>Historial de movimientos</h2><div class="table-scroll"><table><thead><tr><th>Fecha</th><th>Operación</th><th>Estado</th><th>Secciones</th><th>Motivo</th><th>Usuario</th></tr></thead><tbody><c:forEach items="${movimientos}" var="m"><tr><td><c:out value="${m.creado_en}"/></td><td><c:out value="${m.tipo}"/></td><td><c:out value="${m.estado_anterior}"/> → <c:out value="${m.estado_nuevo}"/></td><td><c:out value="${m.origen}"/> → <c:out value="${m.destino}"/></td><td><c:out value="${m.motivo}"/></td><td><c:out value="${m.usuario}"/></td></tr></c:forEach></tbody></table></div></section>
