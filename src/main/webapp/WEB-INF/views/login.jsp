<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Acceso · Matrícula escolar</title><link rel="stylesheet" href="<c:url value='/assets/app.css'/>"></head>
<body class="login"><div class="login-intro"><span class="eyebrow">GESTIÓN ESCOLAR</span><h1>Una matrícula.<br>Toda la información.</h1><p>Estudiantes, responsables y vacantes en un solo lugar.</p></div><section class="login-card"><span class="brand-mark">M</span><h2>Bienvenido</h2><p>Ingresa con tu cuenta institucional.</p><c:if test="${not empty error}"><div class="notice" role="alert"><c:out value="${error}"/></div></c:if>
<form method="post" action="<c:url value='/login'/>"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><label>Usuario<input name="username" autocomplete="username" maxlength="50" required autofocus></label><label>Contraseña<input type="password" name="password" autocomplete="current-password" maxlength="128" required></label><button type="submit">Ingresar</button></form><small>El administrador crea las cuentas y asigna los permisos.</small></section></body></html>
