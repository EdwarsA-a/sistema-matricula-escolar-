<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<div class="page-heading"><div><span class="eyebrow">TRAZABILIDAD</span><h1>Bitácora de operaciones</h1><p>Últimas 300 operaciones. Solo el administrador tiene acceso.</p></div></div>
<section class="panel"><div class="table-scroll"><table><thead><tr><th>Fecha</th><th>Usuario</th><th>Acción</th><th>Registro</th><th>Detalle</th></tr></thead><tbody><c:forEach items="${rows}" var="row"><tr><td><c:out value="${row.creado_en}"/></td><td><c:out value="${row.username}"/></td><td><c:out value="${row.accion}"/></td><td><c:out value="${row.entidad}"/> #<c:out value="${row.registro_id}"/></td><td><details><summary>Ver cambios</summary><pre><c:out value="${row.detalle}"/></pre></details></td></tr></c:forEach><c:if test="${empty rows}"><tr><td colspan="5">No hay operaciones registradas.</td></tr></c:if></tbody></table></div></section>
