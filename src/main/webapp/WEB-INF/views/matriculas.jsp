<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<div class="page-heading"><div><span class="eyebrow">REGISTRO ACADÉMICO</span><h1>Matrículas</h1><p>Las solicitudes pendientes no ocupan vacante hasta su activación.</p></div></div>
<section class="panel"><h2>Nueva solicitud</h2><form class="form-grid" method="post" action="<c:url value='/app/matriculas/crear'/>"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>">
<label>Estudiante<select name="estudiante_id" required><option value="">Seleccione</option><c:forEach items="${estudiantes}" var="e"><option value="${e.id}"><c:out value="${e.codigo}"/> · <c:out value="${e.apellidos}"/>, <c:out value="${e.nombres}"/></option></c:forEach></select></label>
<label>Periodo<select name="periodo_id" id="periodo-select" required><option value="">Seleccione</option><c:forEach items="${periodos}" var="p"><c:if test="${p.estado eq 'ABIERTO'}"><option value="${p.id}"><c:out value="${p.codigo}"/></option></c:if></c:forEach></select></label>
<label class="full">Sección<select name="seccion_id" id="seccion-select" required><option value="">Seleccione</option><c:forEach items="${secciones}" var="s"><c:if test="${s.activa}"><option value="${s.id}" data-periodo="${s.periodo_id}"><c:out value="${s.periodo}"/> / <c:out value="${s.nivel}"/> / <c:out value="${s.grado}"/> / <c:out value="${s.nombre}"/> · <c:out value="${s.disponibles}"/> vacantes</option></c:if></c:forEach></select></label>
<label class="full">Observación<textarea name="observacion" maxlength="500" rows="2"></textarea></label><div class="full"><button>Crear solicitud pendiente</button></div></form></section>
<section class="panel"><form class="search" method="get"><input name="q" placeholder="Código de matrícula, estudiante o nombre" value="<c:out value='${q}'/>"><button>Buscar</button></form><div class="table-scroll"><table><thead><tr><th>Estudiante</th><th>Periodo</th><th>Sección</th><th>Estado</th><th></th></tr></thead><tbody><c:forEach items="${rows}" var="row"><tr><td><strong><c:out value="${row.estudiante}"/></strong><small><c:out value="${row.codigo_estudiante}"/></small></td><td><c:out value="${row.periodo}"/></td><td><c:out value="${row.seccion}"/></td><td><span class="badge ${row.estado eq 'ACTIVA' ? 'success' : ''}"><c:out value="${row.estado}"/></span></td><td><a href="<c:url value='/app/matriculas/detalle'><c:param name='id' value='${row.id}'/></c:url>">Abrir</a></td></tr></c:forEach><c:if test="${empty rows}"><tr><td colspan="5">No se encontraron matrículas.</td></tr></c:if></tbody></table></div></section>
