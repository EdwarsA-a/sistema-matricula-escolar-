<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<div class="page-heading"><div><span class="eyebrow">FICHAS</span><h1>Estudiantes</h1><p>Una ficha por estudiante. Busca por código, documento o nombre.</p></div></div>
<section class="panel"><h2>${empty edit ? 'Nuevo estudiante' : 'Actualizar estudiante'}</h2><form class="form-grid" method="post" action="<c:url value='/app/estudiantes/guardar'/>">
<input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="id" value="<c:out value='${edit.id}'/>">
<label>Código institucional<input name="codigo" maxlength="30" value="<c:out value='${edit.codigo}'/>" required></label>
<label>Tipo de documento<select name="tipo_documento"><option ${edit.tipo_documento eq 'DNI' ? 'selected' : ''}>DNI</option><option ${edit.tipo_documento eq 'CE' ? 'selected' : ''}>CE</option><option ${edit.tipo_documento eq 'PASAPORTE' ? 'selected' : ''}>PASAPORTE</option><option ${edit.tipo_documento eq 'OTRO' ? 'selected' : ''}>OTRO</option></select></label>
<label>Documento<input name="documento" maxlength="20" value="<c:out value='${edit.documento}'/>"></label><label>Fecha de nacimiento<input type="date" name="fecha_nacimiento" value="<c:out value='${edit.fecha_nacimiento}'/>" required></label>
<label>Nombres<input name="nombres" maxlength="80" value="<c:out value='${edit.nombres}'/>" required></label><label>Apellidos<input name="apellidos" maxlength="100" value="<c:out value='${edit.apellidos}'/>" required></label>
<label class="full">Dirección<input name="direccion" maxlength="200" value="<c:out value='${edit.direccion}'/>" required></label>
<label class="check"><input type="checkbox" name="identidad_verificada" ${edit.identidad_verificada ? 'checked' : ''}>Identidad verificada</label><label class="check"><input type="checkbox" name="activo" ${empty edit or edit.activo ? 'checked' : ''}>Ficha activa</label>
<label class="check full"><input type="checkbox" name="confirmarCoincidencia">Revisé las coincidencias de nombres y nacimiento y confirmo que es otra persona.</label>
<div class="actions full"><button type="submit">Guardar ficha</button><a class="button secondary" href="<c:url value='/app/estudiantes'/>">Limpiar formulario</a></div></form></section>
<section class="panel"><form class="search" method="get"><input name="q" placeholder="Código, documento o nombre" value="<c:out value='${q}'/>" maxlength="100"><button>Buscar</button></form><div class="table-scroll"><table><thead><tr><th>Código</th><th>Estudiante</th><th>Documento</th><th>Identidad</th><th>Estado</th><th></th></tr></thead><tbody><c:forEach items="${rows}" var="row"><tr><td><c:out value="${row.codigo}"/></td><td><c:out value="${row.apellidos}"/>, <c:out value="${row.nombres}"/></td><td><c:out value="${row.documento}"/></td><td><span class="badge">${row.identidad_verificada ? 'Verificada' : 'Pendiente'}</span></td><td>${row.activo ? 'Activa' : 'Inactiva'}</td><td><a href="<c:url value='/app/estudiantes'><c:param name='editar' value='${row.id}'/></c:url>">Editar</a></td></tr></c:forEach><c:if test="${empty rows}"><tr><td colspan="6">No se encontraron estudiantes.</td></tr></c:if></tbody></table></div></section>
