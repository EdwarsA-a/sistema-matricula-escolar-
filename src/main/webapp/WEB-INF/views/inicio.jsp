<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<div class="page-heading"><div><span class="eyebrow">PANEL GENERAL</span><h1>Gestión de matrícula</h1><p>Consulta el estado del registro y continúa con tus operaciones.</p></div></div>
<section class="metrics"><article><span>Estudiantes</span><strong><c:out value="${resumen.estudiantes}"/></strong></article><article><span>Apoderados</span><strong><c:out value="${resumen.apoderados}"/></strong></article><article><span>Matrículas activas</span><strong><c:out value="${resumen.activas}"/></strong></article><article><span>Pendientes</span><strong><c:out value="${resumen.pendientes}"/></strong></article></section>
<section class="panel"><h2>El proceso de matrícula</h2><ol class="steps"><li><strong>Registra las fichas</strong><p>Busca al estudiante y al apoderado antes de crear un registro.</p></li><li><strong>Vincula al responsable</strong><p>Indica la relación con el estudiante y el responsable principal.</p></li><li><strong>Crea una solicitud</strong><p>Selecciona el periodo y una sección. La solicitud queda pendiente.</p></li><li><strong>Verifica y activa</strong><p>Revisa la identidad, el responsable y los documentos. El sistema comprobará la vacante.</p></li></ol>
<c:if test="${sessionScope.usuario.operador}"><a class="button" href="<c:url value='/app/matriculas'/>">Ir a matrículas</a></c:if><a class="button secondary" href="<c:url value='/app/vacantes'/>">Consultar vacantes</a></section>
