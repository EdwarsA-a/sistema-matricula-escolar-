<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<div class="page-heading"><div><span class="eyebrow">ADMINISTRACIÓN</span><h1>Configuración académica</h1><p>Define periodos, secciones, capacidad y requisitos documentales.</p></div></div>
<section class="panel"><h2>Nuevo periodo</h2><form class="form-grid" method="post" action="<c:url value='/app/configuracion/periodo'/>"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><label>Código<input name="codigo" maxlength="20" placeholder="2027" required></label><label>Estado<select name="estado"><option>PLANIFICADO</option><option>ABIERTO</option><option>CERRADO</option></select></label><label>Inicio<input type="date" name="fecha_inicio" required></label><label>Fin<input type="date" name="fecha_fin" required></label><div class="full"><button>Crear periodo</button></div></form></section>
<section class="panel"><h2>Periodos registrados</h2><c:forEach items="${periodos}" var="p"><form class="editable-row" method="post" action="<c:url value='/app/configuracion/periodo'/>"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="id" value="${p.id}"><label>Código<input name="codigo" value="<c:out value='${p.codigo}'/>" maxlength="20" required></label><label>Inicio<input type="date" name="fecha_inicio" value="${p.fecha_inicio}" required></label><label>Fin<input type="date" name="fecha_fin" value="${p.fecha_fin}" required></label><label>Estado<select name="estado"><option ${p.estado eq 'PLANIFICADO' ? 'selected' : ''}>PLANIFICADO</option><option ${p.estado eq 'ABIERTO' ? 'selected' : ''}>ABIERTO</option><option ${p.estado eq 'CERRADO' ? 'selected' : ''}>CERRADO</option></select></label><button class="small">Guardar</button></form></c:forEach></section>
<section class="panel"><h2>Nueva sección</h2><form class="form-grid" method="post" action="<c:url value='/app/configuracion/seccion'/>"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><label>Periodo<select name="periodo_id" required><c:forEach items="${periodos}" var="p"><option value="${p.id}"><c:out value="${p.codigo}"/></option></c:forEach></select></label><label>Grado<select name="grado_id" required><c:forEach items="${grados}" var="g"><option value="${g.id}"><c:out value="${g.nivel}"/> / <c:out value="${g.nombre}"/></option></c:forEach></select></label><label>Nombre de sección<input name="nombre" placeholder="A" maxlength="20" required></label><label>Capacidad<input type="number" name="capacidad" min="1" max="1000" required></label><label class="check full"><input type="checkbox" name="activa" checked>Sección activa</label><div class="full"><button>Crear sección</button></div></form></section>
<section class="panel"><h2>Secciones registradas</h2><c:forEach items="${secciones}" var="s"><form class="editable-row" method="post" action="<c:url value='/app/configuracion/seccion'/>"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="id" value="${s.id}"><input type="hidden" name="periodo_id" value="${s.periodo_id}"><input type="hidden" name="grado_id" value="${s.grado_id}"><strong><c:out value="${s.periodo}"/> / <c:out value="${s.nivel}"/> / <c:out value="${s.grado}"/></strong><label>Sección<input name="nombre" value="<c:out value='${s.nombre}'/>" maxlength="20" required></label><label>Capacidad<input type="number" name="capacidad" value="${s.capacidad}" min="1" max="1000" required></label><label class="check"><input type="checkbox" name="activa" ${s.activa ? 'checked' : ''}>Activa</label><button class="small">Guardar</button></form></c:forEach></section>
<section class="panel"><h2>Nuevo requisito documental</h2><form class="form-grid" method="post" action="<c:url value='/app/configuracion/documento'/>"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><label class="full">Nombre<input name="nombre" maxlength="100" required></label><label class="check"><input type="checkbox" name="obligatorio" checked>Obligatorio</label><label class="check"><input type="checkbox" name="activo" checked>Activo</label><div class="full"><button>Crear requisito</button></div></form></section>
<section class="panel"><h2>Requisitos registrados</h2><c:forEach items="${documentos}" var="d"><form class="editable-row" method="post" action="<c:url value='/app/configuracion/documento'/>"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="id" value="${d.id}"><label>Nombre<input name="nombre" maxlength="100" value="<c:out value='${d.nombre}'/>" required></label><label class="check"><input type="checkbox" name="obligatorio" ${d.obligatorio ? 'checked' : ''}>Obligatorio</label><label class="check"><input type="checkbox" name="activo" ${d.activo ? 'checked' : ''}>Activo</label><button class="small">Guardar</button></form></c:forEach></section>
